{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rongmeihymnal.app/schemas/book-metadata.schema.json",
  "title": "Rongmei Hymnal book metadata",
  "type": "object",
  "required": ["schemaVersion", "contentVersion", "id", "name", "title", "subtitle", "language", "cover", "intro", "credits", "songs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "contentVersion": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "cover": {
      "type": "object",
      "required": ["image", "alt"],
      "properties": {"image": {"type": "string", "minLength": 1}, "alt": {"type": "string", "minLength": 1}}
    },
    "theme": {
      "type": "object",
      "properties": {"accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{3,8}$"}, "accentSoft": {"type": "string", "pattern": "^#[0-9A-Fa-f]{3,8}$"}}
    },
    "intro": {"type": "object", "required": ["summary", "description"], "properties": {"summary": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "credits": {"type": "object", "required": ["editor", "compiledBy", "publisher", "year", "rights"]},
    "changelog": {"type": "array", "items": {"type": "object", "required": ["date", "note"], "properties": {"date": {"type": "string"}, "note": {"type": "string", "minLength": 1}}}},
    "songs": {"type": "object", "required": ["file", "url", "count", "updatedAt"], "properties": {"file": {"type": "string"}, "url": {"type": "string"}, "count": {"type": "integer", "minimum": 1}, "updatedAt": {"type": "string", "minLength": 1}}}
  }
}
